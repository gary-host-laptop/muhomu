<div class="widget-body"><table id="calendarTable">{{range .}}<tr>{{if .LeftDay}}<td class="col-left-num{{if .LeftToday}} today{{end}}">{{.LeftDay}}</td><td class="col-left-wk{{if .LeftToday}} today{{end}}">{{.LeftWeekday}}</td>{{else if .Year}}<td rowspan="2" colspan="2" class="cal-year">{{.Year}}</td>{{end}}{{if .Month}}<td rowspan="2" colspan="2" class="cal-header-year cal-header-today" style="border-bottom:1px solid var(--border);">{{.Month}}</td>{{else if .RightDay}}<td class="col-right-num{{if .RightToday}} today{{end}}">{{.RightDay}}</td><td class="col-right-wk{{if .RightToday}} today{{end}}">{{.RightWeekday}}</td>{{else if .EmptyRight}}<td class="col-right-num"></td><td class="col-right-wk"></td>{{end}}</tr>{{end}}</table></div>
