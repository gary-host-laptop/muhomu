<div class="kanji-block">
  <div class="kanji-char" id="kanji-char">
    <a href="https://jisho.org/search/{{urlquery .K}}%20%23kanji"
       style="color:inherit;text-decoration:none;">{{.K}}</a>
  </div>
  <div class="kanji-reading" id="kanji-reading">{{.R}}</div>
  <div class="kanji-divider"></div>
  <div class="kanji-meta">
    <span class="kanji-level {{.L}}" id="kanji-level">{{.L}}</span>
  </div>
  <div class="kanji-meaning" id="kanji-meaning">{{.M}}</div>
</div>
