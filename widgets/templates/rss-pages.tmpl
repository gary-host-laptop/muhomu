{{$horizontal := .Horizontal}}<div data-pager-wrap>{{range .Pages}}<div data-page="{{.Index}}" class="rss-page{{if .Active}} active{{end}}">{{range .Items}}{{if $horizontal}}<a href="{{.URL}}" rel="noopener" class="rss-card">{{if .ImageURL}}<div class="rss-card-img"><img src="{{.ImageURL}}" alt="" loading="lazy"></div>{{end}}<div class="rss-card-body"><div class="rss-card-title">{{.Title}}</div><div class="rss-card-meta">{{.FeedTitle}} · {{.Published}}</div></div></a>{{else}}<a href="{{.URL}}" rel="noopener" class="rss-item">{{if .FaviconURL}}<img class="rss-fav" src="{{.FaviconURL}}" alt="" loading="lazy">{{end}}<div class="rss-item-body"><div class="rss-item-title">{{.Title}}</div><div class="rss-item-meta">{{.FeedTitle}} · {{.Published}}</div></div></a>{{end}}{{end}}</div>{{end}}</div>
