<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>無 · new tab</title>
        <style>{{.CriticalStyle}}</style>
        <link rel="stylesheet" href="/static/theme.css" />
        <style>{{.FontStyle}}</style>
        <!-- Preload the fonts used by first paint. With font-display:
             swap the page renders with fallbacks instantly and the
             preload lets the webfonts arrive sooner for the swap. -->
        <link rel="preload" as="font" type="font/ttf" crossorigin href="/static/assets/fonts/Inter-VariableFont_opsz,wght.ttf" />
        <link rel="preload" as="font" type="font/ttf" crossorigin href="/static/assets/fonts/DotGothic16-Regular.ttf" />
        <link rel="preload" as="font" type="font/ttf" crossorigin href="/static/assets/fonts/Orbitron-VariableFont_wght.ttf" />
        <link rel="preload" as="font" type="font/woff2" crossorigin href="/static/assets/fonts/Phosphor-Light.woff2" />
        <link rel="stylesheet" href="/static/phosphor-light.css" />
        <link rel="stylesheet" href="/static/newtab.css" />
        {{.ThemeCSSLinks}}
        <link rel="icon" href="/static/assets/icons/favicon.svg" type="image/svg+xml">
    </head>
    <body class="{{.BodyClass}}" {{.BodyData}}>
        <script>
            window.__INITIAL_DATA__ = {{ .InitialData }};
        </script>
        {{ .BgHTML }}
        <div id="crt"></div>
        <div id="ctx-menu"></div>
        <div class="page">
            <!-- ── HEADER ───────────────────────────────────────────
                 The header strip is a widget list (config `header`),
                 rendered chrome-less left to right. Default: clock,
                 identity, profile. -->
            <header class="header">
                {{ .HeaderHTML }}
            </header>

            <!-- ── SEARCH STRIP ────────────────────────────────────────
                 The search widget's classic home. Rendered only when
                 search isn't placed in the header or in a column. -->
            {{ if .SearchStripHTML }}
            <div>
                <div class="accent-strip">
                    <span></span><span></span><span></span>
                </div>
                {{ .SearchStripHTML }}
            </div>
            {{ end }}

            <!-- ── MAIN GRID ───────────────────────────────────────── -->
            <div class="grid" style="--grid-cols: {{.GridCols}};">
                {{range .Columns}}
                <div class="col">
                    {{range .Widgets}}{{widgetHTML $.Widgets .Key}}{{end}}
                </div>
                {{end}}
            </div>
            <!-- /grid -->

            <footer class="page-footer">
                <div class="footer-inner" hx-get="/api/footer-stats" hx-trigger="every 2s" hx-target="this" hx-swap="innerHTML">
                    {{.FooterHTML}}
                </div>
            </footer>

        </div>
        <!-- /page -->

        <script src="/static/i18n.js"></script>
        <script src="/static/js/htmx.min.js"></script>
        <script src="/static/newtab.js"></script>
        <script src="/static/js/pager.js"></script>
        {{range .ActiveWidgetIDs}}<script src="/static/js/widget-{{.}}.js"></script>
{{end}}    </body>
</html>
