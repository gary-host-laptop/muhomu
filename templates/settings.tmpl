<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>無 · settings</title>
        <link rel="stylesheet" href="/static/theme.css" />
        <link rel="stylesheet" href="/static/phosphor-light.css" />
        <link rel="stylesheet" href="/static/css/settings-base.css" />
        <link rel="stylesheet" href="/static/css/settings-forms.css" />
        <link rel="stylesheet" href="/static/css/settings-lists.css" />
        <link rel="stylesheet" href="/static/css/settings-chrome.css" />
        <link rel="icon" href="/static/assets/icons/favicon.svg" type="image/svg+xml">
    </head>
    <body class="theme-dark">
        <div class="page">
            <!-- HEADER -->
            <header class="header">
                <div>
                    <div class="header-title">設定</div>
                    <div class="header-sub">muhomu · settings</div>
                </div>
                <a class="back-btn" href="/">‹ new tab</a>
            </header>

            <!-- Sections are rendered by the settings module from the schema.
                 The page is data-driven: GET /api/settings provides the
                 current config, and saving POSTs it back — the server
                 writes config.yaml and hot-reload does the rest. -->
            <div id="sections"></div>

            <!-- SAVE BAR -->
            <div class="save-bar" id="save-bar">
                <span class="save-status" id="save-status">—</span>
                <button class="btn" id="reset-btn">↺ reset to defaults</button>
                <button class="btn primary" id="save-btn" disabled>save</button>
            </div>
        </div>

        <script type="module" src="/static/js/settings/main.js"></script>
    </body>
</html>
